# ============================================================
# OpenSEO++ — environment template (copy to .env; NEVER commit .env)
# Mode switches only. No secrets in this file.
# ============================================================

# ── Central integration switch ─────────────────────────────
# mock = offline fixtures, zero external network calls (default)
# live = real third-party API calls (credentials required below)
INTEGRATION_MODE=mock

# Auth + webhook hardening (Category 2, P2) --------------------------------
# API_AUTH_TOKEN: when set, every protected API prefix requires
#   'Authorization: Bearer <value>' (timing-safe compare). Unset = local dev.
# API_AUTH_TOKEN=
# GITHUB_WEBHOOK_SECRET: same value in the GitHub webhook's Secret field;
#   webhook requests are HMAC-SHA256-verified (X-Hub-Signature-256).
#   Unset = signature NOT verified (loud warning logged).
# GITHUB_WEBHOOK_SECRET=

# LLM providers (agent + drafting) ------------------------------------------------
# Requests route to the PRIMARY provider and fall back to the SECONDARY on an
# availability failure (HTTP 4xx/5xx, timeout, connection error, or missing
# credentials). A parse failure is NOT an availability failure and does not
# fall back by default, so a model-quality regression cannot hide behind it.
# Both keys are optional, but at least one must be set or drafting cannot run.
# A CircuitBreaker skips the primary after 3 consecutive availability failures
# (persistent failures such as a lapsed subscription are not retried per call).
#
# PRIMARY - Ollama Cloud (OpenAI-compatible chat completions):
# OLLAMA_API_KEY=
# OLLAMA_API_BASE=https://ollama.com/v1
# OLLAMA_MODEL=gpt-oss:120b
#
# SECONDARY - Gemini (Google Generative Language API):
# GEMINI_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.6-flash

# DB pooling + TLS (Category 2, P3) -----------------------------------------
# POSTGRES_SSLMODE: TLS mode for Postgres connections. Unset = auto:
#   'require' for managed hosts (anything not localhost — Supabase etc.),
#   no sslmode for local Docker (no TLS). Explicit values always win.
# POSTGRES_SSLMODE=
# Pool bounds for the API request path ONLY (psycopg2
# ThreadedConnectionPool; jobs/scripts still open their own connections).
# Serverless caution: the pool is per warm instance — keep DB_POOL_MAX
# low (4-8) so concurrent lambdas cannot exhaust the Supabase pooler.
# DB_POOL_MIN=0
# DB_POOL_MAX=8
