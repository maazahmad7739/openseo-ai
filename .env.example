# ============================================================
# OpenSEO++ — environment template (copy to .env; NEVER commit .env)
# Mode switches only. No secrets in this file.
# ============================================================

# ── Central integration switch ─────────────────────────────
# mock = offline fixtures, zero external network calls (default)
# live = real third-party API calls (credentials required below)
INTEGRATION_MODE=mock

# ── Operator-loop notifications (optional) ─────────────────
# Single webhook URL that receives run summaries: measurement verdicts
# (Won/Lost/Neutral), stale approvals, weekly agent/candidate summaries.
# Slack-compatible body (text + blocks). Unset = notifications silently
# skipped, jobs still succeed (never a crash, never a blocked workflow).
# NOTIFICATION_WEBHOOK_URL=

# Per-connector overrides (optional; legacy switches still honored)
# OPENSEO_MOCK_MODE=1
# GSC_MOCK_MODE=1
# SHOPIFY_MOCK_MODE=1
# GA4_MOCK_MODE=1

# ── Local Postgres (Docker, phase 1) ───────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openseo
POSTGRES_USER=openseo
POSTGRES_PASSWORD=openseo_local_only

# ── Live credentials (fill ONLY when switching to live) ────
# OpenSEO / DataForSEO (global, one company account)
# Pre-combined key ("login:password" base64-ready) OR the login/password pair:
# DATAFORSEO_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Google Search Console (per-site service account)
# Any ONE of: key file path, canonical ADC-style path alias, or inline JSON:
# GSC_SERVICE_ACCOUNT_KEY_FILE=C:\path\to\service-account-key.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# GSC_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}   # inline JSON
# GSC_SITE_URL=sc-domain:example.com

# Shopify (per-site) — canonical names + aliases both honored:
# SHOPIFY_DOMAIN=example.myshopify.com          (alias: SHOPIFY_STORE_DOMAIN)
# SHOPIFY_ACCESS_TOKEN=                         (alias: SHOPIFY_ADMIN_ACCESS_TOKEN)

# GA4 (per-site OAuth)
# GA4_PROPERTY_ID=
# GA4_ACCESS_TOKEN=

# ── AI agent (phase 4) ─────────────────────────────────────
# Ollama Cloud = hosted provider (no offline stub; agent refuses to run
# without credentials, loudly). NOTE: there is no AGENT_MODE switch — the
# agent always targets the hosted API and fails loudly without credentials.
# OLLAMA_API_BASE=https://ollama.com/v1
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b

# ── Multi-site job execution (Phase 5) ─────────────────────
# Bounded concurrency for per-site weekly jobs (weekly_candidates,
# weekly_agent, orchestrator). Default 1 = strictly sequential, the safe
# baseline for DataForSEO rate limits. Raise only when quota allows parallel
# per-site work; never run naive full-parallelism across unlimited sites.
# Each site runs on its own DB connection (workers never share one).
# JOB_MAX_WORKERS=1
# Optional per-site wall-clock timeout in seconds (unset/0 = no timeout). A
# site that exceeds it is recorded as failed while the rest of the batch runs.
# JOB_TIMEOUT_SECONDS=