{
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["vite.config.ts"],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // ES2022 is the browser floor per the open-seo repo policy: use Remeda's
    // sort/sortBy instead of ES2023 array methods.
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}